model {
    data-gebruiker = actor 'Data gebruiker' {
        description 'Een data gebruiker is een persoon die gezondheidsgegevens gebruikt voor onderzoek, innovatie of beleid.'

        -> plugin.ph.plugin-ml 'maakt federatieve ML pipelines aan via PLUGIN-ML client'
        -> plugin.ph.vantage6-ui 'beheert federatieve samenwerking in'
    }
    data-houder = actor 'Data houder' {
        description 'Een data houder is een persoon of organisatie die gezondheidsgegevens beheert en beschikbaar stelt aan data gebruikers.'
        -> epic 'registreert patiëntgegevens in'
        -> hix 'registreert patiëntgegevens in'
        -> epd-overig 'registreert patiëntgegevens in'
    }

    epic = system 'Epic' {
        description 'Elektronisch patiëntendossier (EPD) van Epic Systems. Biedt data aan via FHIR API.'
        technology 'FHIR R4 API'
    }
    hix = system 'HiX' {
        description 'Elektronisch patiëntendossier (EPD) van ChipSoft. Data extractie via queries.'
        technology 'SQL / ChipSoft queries'
    }
    epd-overig = system 'Overig EPD / bronsysteem' {
        description 'Andere bronsystemen waaruit gezondheidsgegevens geëxtraheerd kunnen worden.'
        style {
            color plugin-light-grey
        }
    }
    pseudonimisatie = system 'Pseudonimisatie' {
        description 'Optioneel extern systeem dat persoonsidentificerende gegevens vervangt door pseudoniemen voordat data het datastation bereikt.'
        style {
            color plugin-light-grey
        }
    }

    plugin = system 'PLUGIN' {
        description 'Een data space.'
        link ./model.c4#L8 'Model'

        datastation = system 'Datastation' {
            description 'Beveiligde omgeving waarin datasets en gegevensdiensten van een datahouders worden ontsloten volgens afgesproken standaarden, met expliciete regels voor toegang, autorisatie, logging en gebruik.'

            vantage6-node = container 'vantage6 node' {
                description 'Applicatie die verantwoordelijk is voor het uitvoeren van federatieve berekeningen op de data van een data houder, inclusief het ontvangen van taken, uitvoeren van algoritmes en terugsturen van resultaten.'
            }

            plugin-lake-ui = container 'PLUGIN-Lake UI' {
                description 'Streamlit dashboard container waarmee datahouder inzicht krijgt in de status en logs van het datastation.'
                technology 'Streamlit container'
            }

            dagster-ui = container 'Dagster UI' {
                description 'Dagster web dashboard container voor het ontwerpen, plannen en monitoren van data pipelines.'
                technology 'Dagster web UI container'
                -> dagster-deamon 'stuurt opdrachten naar en ontvangt status updates van'
            }
            dagster-deamon = container 'Dagster Daemon' {
                    description 'Applicatie die verantwoordelijk is voor het uitvoeren van geplande taken en het monitoren van de status van data pipelines in Dagster.'
                    dagster-ducklake-iomanager = component 'Dagster DuckLake IO manager' {
                        description 'Python IO manager (code uit plugin-lake pakket) die geladen wordt door de Dagster daemon en data leest/schrijft naar PLUGIN-Lake via HTTPS/REST.'
                        technology 'Python, gedistribueerd via plugin-lake package'
                    }
            }
            algoritme-container = container 'vantage6 Algorithm Container' {
                description 'Generieke Docker container met vantage6 wrapper voor het uitvoeren van berekeningen op datastation data. Dient als basis template; specifieke algoritmes (zoals PLUGIN-ML) bouwen hierop voort.'
                technology 'Docker, vantage6 wrapper, Python'
            }
            plugin-lake = container 'PLUGIN-Lake' {
                description 'Single Docker container met FastAPI server. Gebruikt DuckLake (DuckDB + PostgreSQL catalog + S3 Parquet opslag) als lakehouse storage layer. Kan federatief communiceren met PLUGIN-Lake instanties op andere datastations en de Processing Hub via Nuts als middleware (native stream).'
                technology 'FastAPI, Python, DuckDB, DuckLake'
            }

            nuts-node = container 'Nuts-node' {
                description 'Decentralized management of identities, autorisation, registries and logging.'
                -> plugin-lake 'registers, secures and logs'
            }

            plugin-rosetta = component 'PLUGIN-Rosetta' {
                description 'Ondersteuning van verschillende informatiemodellen incl. gevalideerde mappings.'
                technology 'LinkML, Python'
                omop = informationmodel 'OMOP CDM 5.4' {
                    description 'Informatiemodel waarin gezondheidsgegevens zijn opgeslagen volgens de OMOP Common Data Model (CDM) 5.4 specificaties.'
                }
                fhir = informationmodel 'FHIR Profiel' {
                    description 'Informatiemodel waarin gezondheidsgegevens zijn opgeslagen volgens de FHIR (Fast Healthcare Interoperability Resources) standaard.'
                }
                lbz = informationmodel 'LBZ' {
                    description 'Informatiemodel waarin gezondheidsgegevens zijn opgeslagen volgens de Landelijke Basisregistratie Ziekenhuiszorg (LBZ) standaard.'
                }
                openehr = informationmodel 'openEHR' {
                    description 'Informatiemodel waarin gezondheidsgegevens zijn opgeslagen volgens de OpenEHR standaard.'
                    style {
                        color plugin-light-grey
                    }
                }
                dcat = informationmodel 'DCAT' {
                    description 'Informatiemodel voor vastleggen van metadata.'
                    }
                sssom = informationmodel 'SSSOM' {
                    description 'Framework voor het vastleggen en onderhouden van gevalideerde mappings.'
                }
                fhir-omop = informationmodel 'FHIR-OMOP' {
                    description 'Mapping van FHIR naar OMOP zoals bepaald in Vulcan project.'
                    link https://hl7vulcan.org/projects/fhir-to-omop/
                }
                eos = informationmodel 'Eos openEHR to OMOP mapping' {
                    description 'Mapping van FHIR naar OMOP zoals bepaald in Vulcan project.'
                    link https://github.com/SevKohler/Eos
                }
                fhir -> fhir-omop 'input voor'
                fhir-omop -> omop 'mapped naar naar'
                fhir-omop -> sssom 'vastgelegd in'
                openehr -> eos 'input voor'
                eos -> omop 'mapped naar'
                eos -> sssom 'vastgelegd in'
            }
            plugin-lake -> plugin-rosetta 'implementeert'

        vantage6-node -> algoritme-container 'zet op, configureert en stuurt resultaten door van'
        algoritme-container -> plugin-lake 'leest data van en schrijft tijdelijke resultaten naar'
        plugin-lake-ui -> plugin-lake 'interface voor inzage in orchestratie en data'
        plugin-lake -> dagster-deamon 'initieert taken en jobs via REST API'
        dagster-deamon -> plugin-lake 'leest en schrijft data via DuckLake IO manager (HTTPS/REST)'
        }
        
        ph = system 'Processing Hub' {
            description 'Een federatieve data processing systeem dat voldoet aan de eisen van beveiligde verwerkingsomgeving (BVO).'

            plugin-lake = container 'PLUGIN-Lake' {
                description 'Single Docker container met FastAPI server voor het opslaan en beheren van lakehouse data op de Processing Hub.'
                technology 'FastAPI, Python'
            }

            nuts-node = container 'Nuts-node' {
                description 'Sidecar container voor autorisatie en authenticatie bovenop PLUGIN-Lake. Decentralized management of identities, autorisation, registries and logging.'
                -> plugin-lake 'registers, secures and logs'
            }

            vantage6-server = container 'vantage6 server' {
                description 'Component die verantwoordelijk is voor het beheren van federatieve berekeningen, inclusief het ontvangen van berekeningsverzoeken, coördineren van taken en verzamelen van resultaten.'
                vantage6-client = component 'vantage6 client' {
                    description 'CLI voor programmatisch aansturen van vantage6 server.'
                    technology 'Python'
                }            
                vantage6-database = datastore 'vantage6 database' {
                    description 'Database waarin gegevens worden opgeslagen die nodig zijn voor het beheren van federatieve berekeningen, zoals gebruikersinformatie, berekeningsverzoeken, taakstatussen en resultaten.'
                }
            }
            centrale-aggregatie-server = component 'Centrale aggregratie server' {
                description 'Component waarin resultaten worden combineerd en geaggreeerd'
                technology 'Python'
            }
            vantage6-ui = container 'vantage6 UI' {
                description 'Docker container met de web UI voor federatieve berekeningen; wordt typisch via een browser tunnel of port-forward benaderd.'
                technology 'Docker container, web UI via browser tunnel'
            }

            algoritme-register = container 'Algoritme register' {
                description 'Component waarin beschikbare algoritmes worden geregistreerd en beheerd, inclusief metadata zoals beschrijving, input/output specificaties en versies.'
            }

            plugin-ml = container 'PLUGIN-ML' {
                description 'Federatief ML framework op de Processing Hub. Dispatcht training taken naar datastations via vantage6 en voert aggregatie uit op de Processing Hub.'
                technology 'Python, PyTorch, Flower (Federated Learning)'
                plugin-ml-client = component 'PLUGIN-ML client' {
                    description 'Python client library waarmee data gebruikers ML pipelines definiëren en indienen bij de PLUGIN-ML service.'
                    technology 'Python package'
                }
                plugin-ml-vantage6-container = component 'PLUGIN-ML vantage6 container' {
                    description 'Vantage6 algorithm container gebaseerd op de generieke vantage6 template. Voert ML pipeline stappen uit: training op het datastation of aggregatie op de Processing Hub.'
                    technology 'Docker, vantage6 wrapper, PyTorch, Flower'
                }
            }

            plugin-analytics = container 'PLUGIN-Analytics' {
                description 'Component die analytische tools en visualisaties biedt voor het interpreteren van resultaten van federatieve berekeningen.'
                style {
                    color plugin-light-grey
                }
                duhden-portaal = container 'DUHDEN Portaal' {
                    description 'Component die een portaal biedt voor data gebruikers om toegang te krijgen tot OMOP databases.'
                    style {
                        color plugin-light-grey
                    }
                }
                -> plugin-lake 'vraagt data en analyses aan via HTTPS/REST'
                -> some-server 'wordt uitgevoerd via'
            }

            plugin-hub = container 'PLUGIN-Hub' {
                description 'Container waarmee data vanuit datastations naar PLUGIN-Lake kunnen worden doorgestuurd.'
            }

            some-server = container 'Nader te bepalen server' {
                description 'Centrale component voor federated analytics.'
                style {
                    color plugin-light-grey
                }
                -> plugin.datastation.plugin-lake 'voert federatieve analyses uit via'
            }

            blob-storage = datastore 'Blob Storage' {
                description 'Opslag voor grote bestanden, zoals modelbestanden, datasets en resultaten van federatieve berekeningen.'
            }


            vantage6-ui -> vantage6-server 'grafische interface voor beheren federatieve berekeningen'
            vantage6-server -> algoritme-register 'slaat goedgekeurde algoritmes op in'
            vantage6-server -> blob-storage 'maakt gebruik van'
            plugin-ml -> vantage6-server 'dispatcht training taken (PLUGIN-ML vantage6 container) naar datastations en aggregatie taken naar PH'
            plugin-hub -> plugin-lake 'verstuurt data en opdrachten via HTTPS/REST'
        }


        data-houder -> plugin.datastation 'maakt data beschikbaar via'
        data-gebruiker -> plugin.ph 'werkt voor secundair gebruik in/met'

        // Stream 1: native PLUGIN-Lake federatie via Nuts als middleware
        // (datastation-to-datastation peer-to-peer werkt op dezelfde manier maar kan niet als self-referentie gemodelleerd worden)
        plugin.ph.plugin-lake -> plugin.datastation.plugin-lake 'federatief data-verzoek (native stream, via Nuts middleware) [HTTPS/REST]'

        // Stream 2: federatieve berekeningen via vantage6
        plugin.ph.vantage6-server -> plugin.datastation.vantage6-node 'stuurt taken naar (vantage6 stream)'
        plugin.datastation.vantage6-node -> plugin.ph.vantage6-server 'stuurt resultaten terug naar (vantage6 stream)'
    }
}